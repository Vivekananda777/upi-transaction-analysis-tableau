      </column>
      <column caption='Successful Transactions' datatype='integer' name='[Calculation_1881846078025731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Status] = &quot;Success&quot;&#13;&#10;    THEN [TransactionID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Failed Transactions' datatype='integer' name='[Calculation_1881846078160900]' role='measure' type='quantitative'>
