      <column caption='Total Transactions' datatype='integer' name='[Calculation_1881846076829696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([TransactionID])' />
      </column>
      <column caption='Total Transaction Value' datatype='real' name='[Calculation_1881846077730817]' role='measure' type='quantitative'>
