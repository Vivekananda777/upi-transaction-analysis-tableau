    <worksheet name='Map Visual'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='18' italic='true' underline='true'>Transaction Value by City</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (UPI+Transactions)' name='federated.0jjmzxo1d372hn1cheke00yw1pds' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.0jjmzxo1d372hn1cheke00yw1pds'>
            <column datatype='real' name='[Amount]' role='measure' type='quantitative' />
            <column caption='Bank Name Received' datatype='string' name='[BankNameReceived]' role='dimension' type='nominal' />
            <column caption='Age Groups ' datatype='string' name='[Calculation_1787007204061184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [CustomerAge] &lt;= 25 THEN &quot;18–25&quot;&#13;&#10;ELSEIF [CustomerAge] &lt;= 35 THEN &quot;26–35&quot;&#13;&#10;ELSE &quot;36+&quot;&#13;&#10;END' />
            </column>
            <column caption='Total Transaction Value' datatype='real' name='[Calculation_1881846077730817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Amount])' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;Bangalore&quot;' value='&quot;Bengaluru&quot;' />
                <semantic-value key='&quot;Delhi&quot;' value='&quot;New Delhi&quot;' />
