      <column caption='Age Groups ' datatype='string' name='[Calculation_1787007204061184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CustomerAge] &lt;= 25 THEN &quot;18–25&quot;&#13;&#10;ELSEIF [CustomerAge] &lt;= 35 THEN &quot;26–35&quot;&#13;&#10;ELSE &quot;36+&quot;&#13;&#10;END' />
