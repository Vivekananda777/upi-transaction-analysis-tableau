      <column caption='Success Rate' datatype='real' name='[Calculation_1881846078275589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Status] = &quot;Success&quot;&#13;&#10;    THEN [TransactionID]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([TransactionID])' />
      </column>
      <column caption='Failure Rate' datatype='real' name='[Calculation_1881846080397318]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Status] = &quot;Failed&quot;&#13;&#10;    THEN [TransactionID]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([TransactionID])' />
      </column>
